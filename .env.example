PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=verify-full
REDIS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHANNEL_HANDLE=@saevond
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_VERIFICATION_FILENAME=
TIKTOK_VERIFICATION_CONTENT=
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
AGENT_KEY=replace-with-a-long-agent-upload-secret
ADMIN_KEY=replace-with-a-different-owner-only-secret
SEO_AI_API_KEY=
SEO_AI_MODEL=
SEO_AI_BASE_URL=https://api.openai.com/v1
VIDIQ_MCP_API_KEY=
VIDIQ_MARKET_RESEARCH=true
VIDIQ_WEEKLY_CREDIT_LIMIT=5
VIDIQ_MCP_URL=https://mcp.vidiq.com/mcp
SEO_AI_TIMEOUT_MS=120000
SEO_DAILY_LIMIT=200
SEO_ANALYSIS_BATCH_SIZE=20
SEO_AUTO_PUBLISH=true
SEO_AUTO_DAILY_LIMIT=15
SEO_SCAN_INTERVAL_MINUTES=15
YOUTUBE_AUTO_PLAYLISTS=true
YOUTUBE_AUTO_PLAYLIST_DAILY_LIMIT=20
YOUTUBE_AUTO_PLAYLIST_BATCH_SIZE=20
YOUTUBE_SEARCH_ANALYTICS_BATCH_SIZE=20
# Gameplay screening auto-enables when at least one provider below is configured.
# Optional emergency kill switch: set ENABLE_GAMEPLAY_SCREENING=false.
GAMEPLAY_VISION_PROVIDER_ORDER=gemini,openai,openai_compatible,anthropic,ollama
GAMEPLAY_VISION_GEMINI_API_KEY=
GAMEPLAY_VISION_GEMINI_MODEL=gemini-3.8-flash
GAMEPLAY_VISION_OPENAI_API_KEY=
GAMEPLAY_VISION_OPENAI_MODEL=gpt-4.1-mini
# OpenAI-compatible gateway; Groq example: https://api.groq.com/openai/v1
GAMEPLAY_VISION_OPENAI_COMPAT_BASE_URL=
GAMEPLAY_VISION_OPENAI_COMPAT_API_KEY=
GAMEPLAY_VISION_OPENAI_COMPAT_MODEL=
GAMEPLAY_VISION_OPENAI_COMPAT_MAX_IMAGES=3
GAMEPLAY_VISION_ANTHROPIC_API_KEY=
GAMEPLAY_VISION_ANTHROPIC_MODEL=claude-haiku-5-5
# Self-hosted option: Ollama needs a reachable endpoint, but no provider API key.
GAMEPLAY_VISION_OLLAMA_BASE_URL=
GAMEPLAY_VISION_OLLAMA_MODEL=llama3.2-vision
GAMEPLAY_VISION_TIMEOUT_MS=180000
# Only verified Twitch VOD/live highlight batches may auto-publish; stays false by default.
HIGHLIGHT_AUTO_PUBLISH=false
# Public-video SEO analysis has a separate opt-in.
ENABLE_VIDEO_ANALYSIS=false
VIDEO_ANALYSIS_MODEL=
# Legacy shared key: still accepted for Gemini gameplay screening and existing-video SEO analysis.
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_TIMEOUT_MS=180000
UPLOAD_DIR=./uploads
